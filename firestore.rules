rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Clients collection - users can only access their own clients
    match /clients/{clientId} {
      // Allow read if the client belongs to the user
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow write if the client belongs to the user
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow create if setting userId to authenticated user
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // Invoices collection - users can only access their own invoices
    match /invoices/{invoiceId} {
      // Allow read if the invoice belongs to the user
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow write if the invoice belongs to the user
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow create if setting userId to authenticated user
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    
    // Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
