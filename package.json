{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "homepage": "http://daniserrano7.github.io/jira-clone/",
  "scripts": {
    "build": "npm run build:css && react-router build",
    "build:css": "tailwindcss -m -i ./src/app/styles/app.css -o ./src/app/styles/app-compiled.css",
    "dev": "concurrently \"pnpm run dev:css\" \"react-router dev\"",
    "dev:css": "tailwindcss -w -i ./src/app/styles/app.css -o ./src/app/styles/app-compiled.css",
    "start": "react-router-serve ./build/server/index.js",
    "start:migrate": "npx prisma migrate deploy && npx prisma db seed && npm run start",
    "setup-db": "npx prisma db push && npx prisma db seed",
    "deploy": "fly deploy -a jira-clone",
    "type-check": "tsc --pretty --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "pnpm exec playwright test",
    "test-coverage": "vitest run --coverage",
    "test-all": "pnpm run type-check && pnpm run lint && pnpm run test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build-storybook-preview-only": "storybook build --preview-only",
    "deploy-storybook": "pnpm run build-storybook && touch ./storybook-static/.nojekyll && gh-pages -d storybook-static -t true"
  },
  "prisma": {
    "seed": "tsx src/infrastructure/db/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@react-router/node": "^7.14.2",
    "@react-router/serve": "^7.14.2",
    "better-sqlite3": "^12.9.0",
    "classix": "^2.2.12",
    "isbot": "^5.1.39",
    "react": "^19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0",
    "react-router": "^7.14.2",
    "react-toastify": "^11.1.0",
    "remix-utils": "^9.3.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-radix": "^4.0.2",
    "tailwindcss-radix-ui": "^0.0.4",
    "tiny-invariant": "^1.3.3",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.59.1",
    "@react-router/dev": "^7.14.2",
    "@react-router/fs-routes": "^7.14.2",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.3.5",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
